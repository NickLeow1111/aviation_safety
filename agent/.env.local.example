# Credentials and endpoints that must never be committed.
#
# Copy to agent/.env.local and fill in. `.env.local` is gitignored.

# ---- event store (Phase 1) ------------------------------------------------
# Local Postgres over the Unix socket with peer auth. No password anywhere.
DATABASE_URL=postgresql:///safetyintel?host=/var/run/postgresql

# ---- OpenSky Network (Phase 3) --------------------------------------------
# OpenSky issues OAuth2 client credentials, not a single API key. Both values
# come from the API client section of your opensky-network.org account.
# The server exchanges them for a bearer token at:
#   https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Credit budget guard: /states/all costs 1 credit for a box up to 25 sq deg and
# a registered account gets 4000 credits/day, so the poller polls only while a
# map is open. Lower this if you also use the account for anything else.
OPENSKY_DAILY_CREDIT_BUDGET=3500
